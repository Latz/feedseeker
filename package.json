{
	"name": "feedseeker",
	"version": "1.1.0",
	"description": "FeedSeeker - Find RSS, Atom, and JSON feeds on any website.",
	"type": "module",
	"bin": {
		"feedseeker": "dist/feedseeker-cli.js",
		"feed-seeker": "dist/feedseeker-cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/types/feedseeker.d.ts",
			"import": "./dist/feedseeker.js",
			"require": "./dist/feedseeker.cjs"
		},
		"./cli": {
			"types": "./dist/types/cli/index.d.ts",
			"import": "./dist/feedseeker-cli.js",
			"require": "./dist/feedseeker-cli.cjs"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:mutation": "STRYKER=1 stryker run",
		"clean": "rimraf dist",
		"dev": "tsc --watch",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint .",
		"lint:fix": "oxlint . --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"validate": "npm run format:check && npm run lint && npm run typecheck && npm run test",
		"prebuild": "npm run clean && npm run typecheck",
		"build": "npm run build:lib && npm run build:cli && npm run build:types",
		"build:lib": "vite build",
		"build:cli": "BUILD_TARGET=cli vite build",
		"build:types": "tsc --emitDeclarationOnly --declarationDir dist/types",
		"prepublishOnly": "npm run typecheck && npm run build && npm test",
		"prepare": "husky"
	},
	"keywords": [
		"rss",
		"atom",
		"feed",
		"finder",
		"rss-finder",
		"feed-discovery",
		"web-feed",
		"syndication",
		"query-parameters",
		"typescript",
		"feed-detector",
		"rss-detector",
		"atom-feed",
		"json-feed"
	],
	"author": "Latz <latz@elektroelch.de>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/Latz/feedseeker.git"
	},
	"bugs": {
		"url": "https://github.com/Latz/feedseeker/issues"
	},
	"homepage": "https://github.com/Latz/feedseeker#readme",
	"dependencies": {
		"async": "^3.2.6",
		"commander": "^14.0.1",
		"linkedom": "^0.18.12",
		"tldts": "^7.4.2",
		"undici": "^8.5.0"
	},
	"optionalDependencies": {
		"node-wreq": "^3.2.0"
	},
	"devDependencies": {
		"@stryker-mutator/core": "^10.1.1",
		"@stryker-mutator/vitest-runner": "^10.1.1",
		"@types/async": "^3.2.25",
		"@types/node": "^25.9.3",
		"@vitest/coverage-v8": "^4.1.8",
		"fast-check": "^4.8.0",
		"husky": "^9.1.7",
		"knip": "^6.16.1",
		"node-wreq": "^3.2.0",
		"oxfmt": "^0.79.0",
		"oxlint": "^1.94.0",
		"rimraf": "^6.1.3",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"lint-staged": {
		"*.{ts,js}": [
			"oxlint --fix"
		]
	},
	"engines": {
		"node": ">=22.0.0"
	}
}
